# Site project only. Never commit real values.
# Stripe test keys (sk_test_..., pk_test_...) until Tim turns on live payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Service role for the Chance Classics Supabase project (rental schema). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Checkout emails Tim through send-notification with this header.
# When it is unset, the site sends the service role key as the bearer instead.
NOTIFY_SECRET=

# Optional. Server jobs may charge a saved card with header x-charge-secret.
# The garage uses the signed-in owner session instead. Falls back to NOTIFY_SECRET.
CHARGE_SECRET=

# Places, Distance Matrix, and the service-area Google Map.
# The service-area page passes this key to the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
